# Copy these into your hosting provider's secret/environment settings.
# Never commit real values or place GOOGLE_API_KEY inside the APK.
GOOGLE_API_KEY=replace_with_your_google_ai_api_key
APP_API_TOKEN=replace_with_a_long_random_secret
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
HOST=0.0.0.0
PORT=8080
